# OpsPilot Environment Configuration Template
# Copy to .env for containerized or local deployment

# Multi-Tenancy & Application
SPRING_PROFILES_ACTIVE=postgres
OPSPILOT_SERVER_PORT=8080
OPSPILOT_STORAGE_DIR=/var/opspilot/storage

# Security & JWT Tokens
OPSPILOT_JWT_SECRET=4c529a67e1a389f4178bcde29401826f58273641b9c7a10283746592019a8b7c
OPSPILOT_JWT_EXPIRATION_MS=900000
OPSPILOT_JWT_REFRESH_EXPIRATION_MS=604800000

# Database Configuration (PostgreSQL)
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_secure_pass_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# AI Extraction Provider
OPSPILOT_AI_PROVIDER=MOCK
OPSPILOT_GEMINI_API_KEY=
OPSPILOT_GEMINI_MODEL=gemini-1.5-flash

# Accounting Export Targets
OPSPILOT_EXPORT_SIMULATOR_ENABLED=true
